#!/bin/sh /etc/rc.common
# ==============================================================================
# Jio JCOW414 Hardware Factory Identity Auto-Provisioner
# ==============================================================================
# Reads the factory GPON Serial Number from /dev/mtdblock13 (reservearea @ 0x1400ac)
# and factory MAC address from /dev/mtdblock0 (bootloader @ 0x3fe48).
# Automatically provisions UCI (econet-xpon.identity) on first boot.
# ==============================================================================

START=39
STOP=90

boot() {
	start
}

start() {
	local sn=""
	local mac=""
	local cur_sn=""

	# Check if already provisioned in UCI
	if command -v uci >/dev/null 2>&1; then
		cur_sn=$(uci -q get econet-xpon.identity.gpon_sn || true)
	fi

	if [ -n "$cur_sn" ]; then
		logger -t jio-gpon-provision "GPON Serial already configured: $cur_sn"
		return 0
	fi

	logger -t jio-gpon-provision "First boot detected: probing factory MTD partitions..."

	# 1. Read Serial Number from mtdblock13 (reservearea offset 0x1400ac, 15 chars)
	if [ -e /dev/mtdblock13 ]; then
		sn=$(dd if=/dev/mtdblock13 bs=1 skip=1310892 count=15 2>/dev/null | tr -cd '[:alnum:]')
	elif [ -e /dev/mtd13ro ]; then
		sn=$(dd if=/dev/mtd13ro bs=1 skip=1310892 count=15 2>/dev/null | tr -cd '[:alnum:]')
	fi

	# Fallback search if offset shifted
	if [ -z "$sn" ] || [ ${#sn} -lt 12 ]; then
		if [ -e /dev/mtdblock13 ]; then
			sn=$(strings /dev/mtdblock13 2>/dev/null | grep -E '^(RSVO|SRCM|JSCM)[A-Z0-9]{8,12}' | head -n 1)
		fi
	fi

	# 2. Read Factory MAC from mtdblock0 (bootloader offset 0x3fe48, 6 bytes)
	if [ -e /dev/mtdblock0 ]; then
		mac=$(hexdump -v -s 261704 -n 6 -e '5/1 "%02x:" 1/1 "%02x"' /dev/mtdblock0 2>/dev/null)
	elif [ -e /dev/mtd0ro ]; then
		mac=$(hexdump -v -s 261704 -n 6 -e '5/1 "%02x:" 1/1 "%02x"' /dev/mtd0ro 2>/dev/null)
	fi

	# Calculate WAN MAC (LAN MAC + 1) if valid MAC found
	local wan_mac=""
	if [ -n "$mac" ]; then
		local o1 o2 o3 o4 o5 o6
		o1=$(echo "$mac" | cut -d: -f1)
		o2=$(echo "$mac" | cut -d: -f2)
		o3=$(echo "$mac" | cut -d: -f3)
		o4=$(echo "$mac" | cut -d: -f4)
		o5=$(echo "$mac" | cut -d: -f5)
		o6=$(echo "$mac" | cut -d: -f6)
		local dec_last=$(( 0x$o6 + 1 ))
		local hex_last
		hex_last=$(printf "%02x" $(( dec_last & 0xff )))
		wan_mac="${o1}:${o2}:${o3}:${o4}:${o5}:${hex_last}"
	fi

	if [ -n "$sn" ]; then
		logger -t jio-gpon-provision "Found factory GPON Serial: $sn"
		[ -n "$wan_mac" ] && logger -t jio-gpon-provision "Found factory WAN MAC: $wan_mac"

		if command -v uci >/dev/null 2>&1; then
			uci -q set econet-xpon.identity=identity || true
			uci set econet-xpon.identity.gpon_sn="$sn"
			[ -n "$wan_mac" ] && uci set econet-xpon.identity.wan_mac="$wan_mac"
			uci commit econet-xpon
			logger -t jio-gpon-provision "Successfully provisioned factory identity to UCI (econet-xpon)"
		fi
	else
		logger -t jio-gpon-provision "Could not automatically extract factory GPON Serial from MTD. Please configure in LuCI."
	fi
}
