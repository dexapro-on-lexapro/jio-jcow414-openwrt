#!/bin/sh /etc/rc.common

USE_PROCD=1
START=42
STOP=88

start_service() {
	local sn
	config_load econet-xpon
	config_get sn identity gpon_sn
	[ -z "$sn" ] && return 0

	ip link set dev omci up 2>/dev/null || ifconfig omci up 2>/dev/null

	procd_open_instance
	procd_set_param command /usr/sbin/omcid omci "$sn"
	procd_set_param respawn
	procd_close_instance
}
