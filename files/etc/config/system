config system
	option hostname 'JioFiber-JCOW414'
	option timezone 'UTC'
	option ttylogin '0'
	option log_size '64'
	option urandom_seed '0'

config timeserver 'ntp'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

# Green LED: Solid ON when router is running
config led 'led_running'
	option name 'System Running (Green)'
	option sysfs 'green:status'
	option trigger 'default-on'
	option default '1'

# Blue LED: Activity on USB Tethering / Network
config led 'led_usb_tether'
	option name 'USB Tether Activity (Blue)'
	option sysfs 'blue:status'
	option trigger 'netdev'
	option dev 'usb0'
	option mode 'link tx rx'
	option default '0'
