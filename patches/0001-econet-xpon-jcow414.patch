+	gponGemPortCfg.Bits.gpid_vld = (isValid==XPON_ENABLE) ? 1 : 0 ;
+	gponGemPortCfg.Bits.gpid_encrypt = (isEncrypted==XPON_ENABLE) ? 1 : 0 ;
