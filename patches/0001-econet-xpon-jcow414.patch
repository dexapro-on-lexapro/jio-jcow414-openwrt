+static inline void restore_gemports(void)
+{
+    ushort i = 0;
+    ushort portID = 0;
+    unchar isEncrypted = 0;
+    PON_MSG(MSG_INT, "Enter \"restore_gemports\".\n");
+	for(i=0 ; i< CONFIG_GPON_MAX_GEMPORT ; i++)
+    {
+		if(!gpWanPriv->gpon.gemPort[i].info.valid){
+            continue;
+		}
