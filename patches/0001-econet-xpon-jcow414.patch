+int isWeigt0(struct sk_buff *skb)
+{
+	int i = 0;
+	int queue;
+	
+	queue = (skb->mark & QOS_FILTER_MARK) >> 4;
+
+	if(queue < 1 || queue >4){	//wrr queue is from 1 to 4
+		return 0;
+	}
+
+	if(qos_wrr_info[queue]){
+		return 0;
+	}else{				//weight is 0
+		return 1;
+	}	
+}
