+@@ -408,6 +488,18 @@ static irqreturn_t en75_irq_handler(int
+ 				disable_int |= BIT(bit);
+ 				continue;
+ 			}
++#ifdef CONFIG_ECONET_XPON
++			if (p.type == IPS_GPON_INT || p.type == IPS_EPON_INT ||
++			    p.type == IPS_XPON_INT) {
++				/* Non-blocking: count + notify the PON sub-driver.
++				 * Mask this bit until the (deferred) handler clears
++				 * the MAC source, so we don't re-storm under the
++				 * irq->lock_irq spinlock. */
++				en75_qdma_pon_dispatch(qdma, p.type);
++				disable_int |= BIT(bit);
++				continue;
++			}
++#endif
+ 			dev_dbg_ratelimited(qdma->dev,
+ 					    "%s IRQ from %s[%d]\n",
+ 					    en75_irq_purpose_type_str(p.type),
+@@ -494,11 +586,16 @@ static int en75_poll_tx_complete(struct
+ 		q->entry[q->freelist_tail].freelist_next = index;
