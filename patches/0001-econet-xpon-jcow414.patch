+/* ---- 2.6.36 -> 6.18 proc_fs compat (compile-milestone) ----
+ * struct proc_dir_entry is opaque now; adapt the legacy single-shot
+ * read_proc / write_proc callbacks to struct proc_ops. */
+typedef int (*phy_old_read_proc_t)(char *page, char **start, off_t off,
+				   int count, int *eof, void *data);
+typedef int (*phy_old_write_proc_t)(struct file *file, const char *buffer,
+				    unsigned long count, void *data);
+struct phy_proc_compat { phy_old_read_proc_t rp; phy_old_write_proc_t wp; void *data; };
+
+static ssize_t phy_proc_compat_read(struct file *f, char __user *ubuf,
+				    size_t cnt, loff_t *pos)
+{
+	struct phy_proc_compat *pc = pde_data(file_inode(f));
+	char *page; int eof = 0, len; ssize_t ret;
+	if (!pc || !pc->rp || *pos > 0)
+		return 0;
+	page = (char *)__get_free_page(GFP_KERNEL);
+	if (!page)
+		return -ENOMEM;
+	len = pc->rp(page, NULL, 0, PAGE_SIZE - 1, &eof, pc->data);
+	if (len < 0) { ret = len; goto out; }
+	if ((size_t)len > cnt) len = cnt;
+	if (copy_to_user(ubuf, page, len)) { ret = -EFAULT; goto out; }
+	*pos += len; ret = len;
+out:
+	free_page((unsigned long)page);
+	return ret;
+}
+static ssize_t phy_proc_compat_write(struct file *f, const char __user *ubuf,
+				     size_t cnt, loff_t *pos)
+{
+	struct phy_proc_compat *pc = pde_data(file_inode(f));
+	if (!pc || !pc->wp)
+		return -EIO;
+	return pc->wp(f, (const char __force *)ubuf, cnt, pc->data);
+}
+static const struct proc_ops phy_proc_compat_ops = {
+	.proc_read  = phy_proc_compat_read,
+	.proc_write = phy_proc_compat_write,
+};
+#define PHY_PROC_CREATE(name, parent, rdfn, wrfn) ({			\
+	static struct phy_proc_compat _pc = { .rp = (rdfn), .wp = (wrfn) }; \
+	proc_create_data((name), 0, (parent), &phy_proc_compat_ops, &_pc); })
