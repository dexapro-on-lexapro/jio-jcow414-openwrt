+		if (PWAN_IF_OMCI == netIdx){
+			skb_push(skb2, 14);
+			memcpy(skb2->data, omciHdr, ARRAY_SIZE(omciHdr));
+		}
+		skb2->mark |= SKBUF_COPYTOLAN;
+        return skb2;
