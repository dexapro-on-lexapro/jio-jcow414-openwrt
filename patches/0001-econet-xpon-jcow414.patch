+/*****************************************************************************
+//function :
+//		get_flash_matrix
+//description : 
+//		this function is used to read the registers from 7570_bob.conf to flash_matrix
+//input :	
+//		N/A
+//output :
+//		0 : success ; -1 : fail
+//		
+******************************************************************************/
+int get_flash_matrix(void)
+{
+	//file open
+	struct file 			*srcf = NULL;
+	char *src = NULL;
+	/* TODO port 2.6.36->6.18: get_fs()/set_fs(KERNEL_DS) removed; use kernel_read() */
+
+	// by Iron Zhang 20151216
+#if !defined(TCSUPPORT_FH_ENV)
+	src = "/tmp/7570_bob.conf";
+#endif
+
+		if (src && *src)
+		{
+			srcf = filp_open(src, O_RDONLY, 0);
+			if (IS_ERR(srcf))
+			{
+				printk("--> Error opening \n");
+				goto error;
+			}
+			else
+			{
+				kernel_read(srcf, flash_matrix, sizeof(flash_matrix), &srcf->f_pos);
+				filp_close(srcf,NULL);
+			}
+		}
+		return 0;
+
+error:
+		return -1;
+
+}
