+void __dump_skb(struct sk_buff *skb, uint pktLen) 
+{
+	unchar n, *p = (unchar *)skb->data ;
+	int i ;
+
+	for(i=0 ; i<pktLen ; i++) {
+		n = i & 0x0f ;
+		
+		if(n == 0x00) 		printk(" \n%.4x: ", i) ;
+		else if(n == 0x08) 	printk(" ") ;
+
+		printk("%.2x ", *p++) ; 
+	}
+	printk("\n") ;
+}
