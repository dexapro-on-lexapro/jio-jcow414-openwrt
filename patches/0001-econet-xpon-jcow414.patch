+	in_data.idx = idx;
+	in_data.conf.off = offset;
+	ret = __ECNT_HOOK(ECNT_PCIE, ECNT_PCIE_API, (struct ecnt_data *)&in_data);
+	*value = in_data.retValue;
+	if(ret != ECNT_HOOK_ERROR)
