+		printk(KERN_DEBUG "en7571_apc: CALIBRATED drive Ibias=0x%03x Imod=0x%03x (want 0x7CE/0x157, NOT raw 0x1FB/0x44D) | delay=%02x T0C=%02x T1C=%02x\n",
+			(uint)(((ib[1] & 0xf) << 8) | ib[0]), (uint)(((im[1] & 0xf) << 8) | im[0]),
