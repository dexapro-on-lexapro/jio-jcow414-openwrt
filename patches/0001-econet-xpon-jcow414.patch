+int isDefaultQueue(struct sk_buff *skb)
+{
+	int queue;
+	queue = skb->mark & QOS_FILTER_MARK;
+		
+	if(queue == 0){
+				return 1;
+	}
+	
+	if(gQueueMask & (1 << ((queue >> 4) -1 ))){ 	//default queue
+		return 0;
+	}else{
+		return 1;
+	}
+}
