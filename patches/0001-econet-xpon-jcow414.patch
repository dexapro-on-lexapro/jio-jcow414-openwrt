+******************************************************************************/
+int gponDevGetDBABlockSize(ushort *blockSize)
+{
+	REG_G_GBL_CFG gponGlbCfg ;
+	
+	gponGlbCfg.Raw = IO_GREG(G_GBL_CFG) ;
+	*blockSize = gponGlbCfg.Bits.sr_blk_size ;
+
+	return 0 ;
+}
