+/*****************************************************************************
+//Function :
+//		mt7570_load_init_current
+//Description : 
+//		This function is to load initial bias and modulation current
+//Input :	
+//		N/A
+//Output :
+//		N/A
+//Date:	
+//		2015/01/29 by HC
+//
+******************************************************************************/
+void mt7570_load_init_current(void)
+{	
+	unchar ptr[4];
+	uint read_data = 0;
+	int temperature_index = 0;
+	
+	//Load I_bias & I_mod from flash
+	if( (get_flash_register(flash_Ibias_init)!=0xffffffff) && (get_flash_register(flash_Imod_init)!=0xffffffff) )
+	{
+		//Read Ibias initial value
+		read_data = get_flash_register(flash_Ibias_init); // & (flash_Ibias_mask);		
+		read_data = read_data & (flash_Ibias_mask);
+		ptr[0] = read_data;
+		ptr[1] = (read_data >> 8);			
+		phy_I2C_write(0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2,  mt7570_P0_PWR_CTRL_CS2, ptr, 2 );		
+
+		//Read Imod initial value
+		read_data = get_flash_register(flash_Imod_init); // & (flash_Imod_mask);		
+		read_data = read_data & (flash_Imod_mask);
+		ptr[0] = read_data;
+		ptr[1] = (read_data >> 8);		
+		phy_I2C_write(0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2,  mt7570_P1_PWR_CTRL_CS2, ptr, 2 );		
+		printk("Initial bias/mod current loaded from FLASH\n");
+	}
+	//Load I_bias & I_mod from LUT				
+	else
+	{
+		//Calculate temperature_index		
+		mt7570_temperature_get();
+		temperature_index = (int)( (BOSA_temperature+40)/2.5 );															//In order to find the relative I_bias and I_mod in LUT_Ibias_Imod
+		if( temperature_index < 0 )																						//temperature_index should be >= 0
+			temperature_index = 0;
+		
+		//Read Ibias initial value
+		read_data = LUT_Ibias_Imod[temperature_index][0];	
+		ptr[0] = read_data;
+		ptr[1] = (read_data >> 8);		
+		phy_I2C_write(0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2,  mt7570_P0_PWR_CTRL_CS2, ptr, 2 );		
+
+		//Read Imod initial value
+		read_data = LUT_Ibias_Imod[temperature_index][1];			
+		ptr[0] = read_data;
+		ptr[1] = (read_data >> 8);		
+		phy_I2C_write(0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2,  mt7570_P1_PWR_CTRL_CS2, ptr, 2 );
+		printk("Initial bias/mod current loaded from LUT\n");
+	}
+}
+
+/* â”€â”€ Ported from H660(DZS) stock en7571_internal_clock / en7571_LUT_Tracking + en7571_tuneBiasModCurrent
+ * (2026-07-05). The port already had the LUT (LUT_Ibias_Imod), mt7570_LUT_recover(), and the temperature
+ * read â€” but it applied Ibias/Imod ONCE at bring-up and never re-tracked them. The H660 stock runs the
+ * tracking in a 1Hz kthread (en7571_internal_clock). These two helpers expose the standalone tracking
+ * step + the combined DAC setter so phy_init.c's servo kthread can drive them periodically. */
+void mt7570_LUT_tracking_step(void)
+{
+	unchar ptr[2];
+	uint ib, im;
+	int idx = (int)((BOSA_temperature + 40) / 2.5);   /* same index math as the load_init_current LUT branch */
+	if (idx < 0)  idx = 0;
+	if (idx > 63) idx = 63;
+	ib = LUT_Ibias_Imod[idx][0];
+	im = LUT_Ibias_Imod[idx][1];
+	if (ib == 0xfff || im == 0xfff)                   /* no valid LUT entry for this temperature -> leave DACs */
+		return;
+	ptr[0] = ib; ptr[1] = (ib >> 8);
+	phy_I2C_write(0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2, mt7570_P0_PWR_CTRL_CS2, ptr, 2);   /* Ibias -> 0x138 */
+	ptr[0] = im; ptr[1] = (im >> 8);
+	phy_I2C_write(0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2, mt7570_P1_PWR_CTRL_CS2, ptr, 2);   /* Imod  -> 0x148 */
+}
+
+/* Faithful port of H660 stock en7571_tuneBiasModCurrent @0x41b58: RMW Ibias(0x138)+Imod(0x148) low
+ * 12 bits. Stock also did set_flash_register((ibias<<16)|imod, 8) to persist â€” OMITTED here to avoid
+ * flash wear/corruption during RE; the servo re-applies from the LUT every period anyway. */
+void en7571_tuneBiasModCurrent(uint ibias, uint imod)
+{
+	unchar ptr[4];
+	ibias &= 0xfff; imod &= 0xfff;
+	phy_I2C_read (0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2, mt7570_P0_PWR_CTRL_CS2, ptr, 4);
+	ptr[0] = ibias & 0xff; ptr[1] = (ptr[1] & 0xf0) | ((ibias >> 8) & 0x0f);
+	phy_I2C_write(0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2, mt7570_P0_PWR_CTRL_CS2, ptr, 4);
+	phy_I2C_read (0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2, mt7570_P1_PWR_CTRL_CS2, ptr, 4);
+	ptr[0] = imod & 0xff;  ptr[1] = (ptr[1] & 0xf0) | ((imod >> 8) & 0x0f);
+	phy_I2C_write(0, gpPhyPriv->i2c_u2_clk_div, 0x70, 2, mt7570_P1_PWR_CTRL_CS2, ptr, 4);
+}
