+/*****************************************************************************
+	I2C Protection
+******************************************************************************/
+atomic_t i2c_protect = ATOMIC_INIT(0);
+
+int 
+i2c_access_protect(void){
+#define MAX_I2C_LOOP	10000
+	int count = MAX_I2C_LOOP;
+	while(atomic_read(&i2c_protect) == 1 ){
+		udelay(1);
+		if(count==0) return -1;
+		count --;
+	}
+	return 0;
+}
