+static inline int should_stop_phy_mode_detect(void)
+{
+    return ( XPON_PHY_SYNC_STATUS_SYNCED  == gpPhyData->detect_status ||\
+             XPON_PHY_SYNC_STATUS_STOPPED == gpPhyData->detect_status );
+}
