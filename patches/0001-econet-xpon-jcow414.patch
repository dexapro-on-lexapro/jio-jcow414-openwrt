+	PHY_TRANS_TX_HIGH_CUR_ALARM 	= 0x04,
+	PHY_TRANS_TX_LOW_CUR_ALARM		= 0x08,
+	PHY_TRANS_RX_HIGH_POWER_ALARM 	= 0x10,
+	PHY_TRANS_RX_LOW_POWER_ALARM 	= 0x20
+} ENUM_PhyTransAlarm ;
