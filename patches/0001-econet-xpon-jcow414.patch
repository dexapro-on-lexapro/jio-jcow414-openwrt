+  /* vendor-proprietary 0xFFFA (65530): DASAN/DZS ME the OLT polls before provisioning.
+   * attr sizes unknown -> model a few small attrs so responses are well-formed (values TBD). */
+  { 65530, {4,4,4,4,4,4,4,4,0} },
