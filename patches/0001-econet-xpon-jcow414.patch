+		//Check the skb headroom is enough or not. shnwind 20100121.
+		if(skb_headroom(skb) < len )
+			skb2 = skb_copy_expand(skb, len , skb_tailroom(skb) , GFP_ATOMIC);
+		else
+			skb2 = skb_copy(skb, GFP_ATOMIC);
