diff --git a/target/linux/econet/base-files/lib/preinit/79_provision_rootfs_data b/target/linux/econet/base-files/lib/preinit/79_provision_rootfs_data
new file mode 100644
index 00000000..13bd7e2e
--- /dev/null
+++ b/target/linux/econet/base-files/lib/preinit/79_provision_rootfs_data
@@ -0,0 +1,44 @@
+# Provision a UBIFS "rootfs_data" overlay volume on the ubi.mtd=opt0 UBI device
+# so mount_root mounts a persistent /overlay (works on both the squashfs-on-NAND
+# and the RAM/initramfs builds - mount_root only cares whether a volume named
+# rootfs_data exists). "opt0" is a spare partition the stock firmware never
+# touches (stock owns ubifs/config_data and ubifs2/config_data2), so the OpenWrt
+# overlay here does not clobber stock's config and the two can coexist across
+# bank switches. Idempotent: a no-op once rootfs_data exists, so it never wipes
+# the overlay on later boots. Runs before 80_mount_root.
+
+provision_rootfs_data_ubi() {
+	grep -q 'ubi.mtd=opt0' /proc/cmdline || return 0
+
+	local mtdnum
+	mtdnum=$(sed -n 's/^mtd\([0-9]*\):.*"opt0"$/\1/p' /proc/mtd)
+	[ -n "$mtdnum" ] || return 0
+
+	# opt0 is a raw/erased partition on a fresh unit, so the kernel ubi.mtd=
+	# attach may not have produced /dev/ubi0 - attach it here. Only reformat
+	# when the attach itself fails: ubiformat is the destructive step, so
+	# trying it first would silently wipe an existing overlay on any boot
+	# where the attach merely raced or the node was late appearing.
+	if [ ! -e /dev/ubi0 ]; then
+		ubiattach -m "${mtdnum}" -d 0 2>/dev/null || {
+			echo "opt0: UBI attach failed, reformatting" >&2
+			ubiformat "/dev/mtd${mtdnum}" -y &&
+				ubiattach -m "${mtdnum}" -d 0
+		} || return 0
+	fi
+	[ -e /dev/ubi0 ] || return 0
+
+	# Confirm ubi0 really is opt0 before creating a max-size volume on it: if
+	# ubi0 belongs to some other MTD (stock owns ubifs/ubifs2), the ubimkvol -m
+	# below would consume that device instead of ours.
+	[ "$(cat /sys/class/ubi/ubi0/mtd_num 2>/dev/null)" = "$mtdnum" ] || return 0
+
+	# already provisioned?
+	ubinfo -d 0 -N rootfs_data >/dev/null 2>&1 && return 0
+
+	# create a max-size rootfs_data overlay volume (kernel formats UBIFS on
+	# first mount by mount_root)
+	ubimkvol /dev/ubi0 -N rootfs_data -m
+}
+
+boot_hook_add preinit_main provision_rootfs_data_ubi
diff --git a/target/linux/econet/base-files/sbin/en75_chboot b/target/linux/econet/base-files/sbin/en75_chboot
index 165a3ebb..6c63d620 100755
--- a/target/linux/econet/base-files/sbin/en75_chboot
+++ b/target/linux/econet/base-files/sbin/en75_chboot
@@ -184,6 +184,20 @@ main() {
         echo "GS3101 does not support A/B partitioning"
         exit 1
         ;;
+    jio,jcow407)
+        # bootbase os1/os2 select: one byte at reservearea offset 0x200000
+        # (block 16 of 128 KiB). 0x30='0' or 0x00 => os1/main (tclinux);
+        # 0x31='1' => os2/slave (tclinux_slave). Disassembly-proven.
+        # OpenWrt is flashed to tclinux (os1) - that is the bank whose nested
+        # partition@480000 carries the "linux,rootfs" node - and stock stays in
+        # tclinux_slave (os2) as the recovery image.
+        part=$(part_named '"reservearea"')
+        offset_blocks=16
+        block_size=$((1024 * 128))
+        code_offset=0
+        code_openwrt=30
+        code_factory=31
+        ;;
     *)
         echo "Unsupported machine: $machine"
         exit 1
diff --git a/target/linux/econet/dts/en7528_jio_jcow407.dts b/target/linux/econet/dts/en7528_jio_jcow407.dts
new file mode 100644
index 00000000..103d539a
--- /dev/null
+++ b/target/linux/econet/dts/en7528_jio_jcow407.dts
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+#include "en7528.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/*
+ * JioFiber JCOW407 (Reliance Jio GPON ONT) â€” EcoNet/Airoha EN7528, MIPS 1004Kc.
+ * First-cut port derived from the in-tree DASAN H660GM-A (Airtel) EN7528 ONT.
+ *
+ * VERIFIED from this unit's serial boot capture (~/407/boot_capture.log):
+ *   - SoC EN7528 (econet,en7528 subtarget), little-endian 1004Kc
+ *   - RAM 512 MB DDR3        (DASAN reference is 256 MB)
+ *   - SPI-NAND Micron MT29F2G01 (256 MB)
+ *   - Wi-Fi MediaTek MT7663  (ChipID 0x7663) -> mt76 (mt7615e + mt7603)
+ *   - Flash partition offsets: bootloader@0, romfile@0x40000, tclinux@0x80000
+ *     (size 0x2800000), tclinux_slave@0x2880000, opt0/opt1/ubifs/config/ubifs2,
+ *     reservearea@0xddc0000 (0x240000)  <- reservearea + bootloader + romfile
+ *     offsets MATCH DASAN exactly.
+ *
+ * UNVERIFIED (inherited from DASAN H660GM-A â€” confirm on-device once root):
+ *   - LED / gpio-keys GPIO numbers
+ *   - MAC base offset inside romfile/dzs (DASAN: macaddr@a in "dzs")
+ *   - Wi-Fi precal/EEPROM offsets inside reservearea (DASAN: 0x40000 / 0x1c0000)
+ *   - usb vbus GPIO, ethernet switch/PHY port map
+ */
+
+/ {
+	model = "JioFiber JCOW407";
+	compatible = "jio,jcow407", "econet,en7528";
+
+	aliases {
+		led-boot = &led_green;
+		led-failsafe = &led_red;
+		led-running = &led_green;
+		led-upgrade = &led_blue;
+		serial0 = &uart;
+	};
+
+	memory@0 {
+		device_type = "memory";
+		/* 512 MB physical, BUT SoC peripheral MMIO sits at 0x1fbf0000 (uart),
+		 * 0x1fb8xxxx (pcie), 0x1fb90000 (usb). A flat 0x0-0x1fffffff RAM node
+		 * overlaps that block, so ioremap() of the UART returns NULL and the
+		 * 8250 probe panics in set_mctrl. The vendor kernel caps usable RAM at
+		 * 0x1affffff, so limit RAM to 0x1b000000 (432 MB) below the MMIO hole. */
+		reg = <0x00000000 0x1b000000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x00020000 0x1afe0000>;
+		/* Attach UBI on the "opt0" partition (mtd) at boot so fstools
+		 * mounts its "rootfs_data" volume as the /overlay â€” persistent
+		 * config on NAND. opt0 is used because the stock firmware owns the
+		 * "ubifs"/"ubifs2" partitions (its config_data /flash + config_data2
+		 * /flash2) and reformats them on boot, so putting the OpenWrt overlay
+		 * there would make stock (Slot A) and OpenWrt clobber each other's
+		 * data. opt0 is untouched by stock, so the two coexist. jffs2-in-
+		 * mtdblock split does not work on NAND. */
+		bootargs = "ubi.mtd=opt0";
+	};
+
+	/*
+	 * Single tri-colour system/status LED on GPIO 2/3/4 (red/green/blue).
+	 * Source: stock JCOW407_R2.35 /userfs/led.conf (tabular led_no/gpio/mode,
+	 * read by tcledctrl.ko), cross-checked via ledctl1 (led_no 78/79/80 ->
+	 * gpio 2/3/4). VERIFIED on hardware: driving red lit the panel LED solid
+	 * red and green is the default power LED -> GPIO map + ACTIVE_LOW polarity
+	 * confirmed. The four RJ45 link/activity LEDs are driven by the MT7530
+	 * switch/PHY in hardware (a linked port lights with no SoC GPIO involved),
+	 * so they are intentionally NOT gpio-leds. led.conf's LANPORT GPIOs
+	 * (31/33/35/37 status, 30/32/34/36 act) drive no visible front-panel LED
+	 * on this board and were dropped after on-HW testing.
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		led_red: red {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
+		};
+
+		led_green: green {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
+		};
+
+		led_blue: blue {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_WAN;
+			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	/* buttons: stock led.conf LED_SYS_RESET=gpio0, LED_WLAN_WPS=gpio1 (mode 5=input) */
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		key-reset {
+			label = "reset";
+			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+
+		key-wps {
+			label = "wps";
+			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+		};
+	};
+
+	reg_usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpios = <&pinctrl 9 GPIO_ACTIVE_HIGH>;	/* UNVERIFIED */
+		enable-active-high;
+	};
+};
+
+&usb {
+	status = "okay";
+	vbus-supply = <&reg_usb_vbus>;
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+};
+
+/* Wi-Fi MT7663 (VERIFIED chip); MAC/precal nvmem offsets inherited â€” UNVERIFIED */
+&slot0 {
+	status = "okay";
+
+	wifi@0,0 {
+		compatible = "mediatek,mt76";
+		reg = <0x0000 0 0 0 0>;
+		nvmem-cells = <&macaddr_boot 8>, <&eeprom_reservearea_1c0000>;
+		nvmem-cell-names = "mac-address", "eeprom";
+		ieee80211-freq-limit = <2400000 2500000>;
+	};
+};
+
+&slot1 {
+	status = "okay";
+
+	wifi@0,0 {
+		compatible = "mediatek,mt76";
+		reg = <0x0000 0 0 0 0>;
+		nvmem-cells = <&macaddr_boot 9>, <&eeprom_reservearea_40000>;
+		nvmem-cell-names = "mac-address", "eeprom";
+		ieee80211-freq-limit = <5000000 6000000>;
+	};
+};
+
+&gmac0 {
+	status = "okay";
+	nvmem-cells = <&macaddr_boot 7>;
+	nvmem-cell-names = "mac-address";
+};
+
+/*
+ * MT7530 DSA switch. The shared en7528.dtsi shrinks the frame-engine
+ * register window so econet-eth no longer sets up the dumb switch; the
+ * on-die MT7530 must be driven by the mt7530 DSA driver instead, or the
+ * board has no LAN. Socket-to-port mapping is UNVERIFIED â€” labels are in
+ * switch-port order for now.
+ */
+&switch {
+	status = "okay";
+};
+
+&gsw_port1 {
+	status = "okay";
+	label = "lan1";
+};
+
+&gsw_port2 {
+	status = "okay";
+	label = "lan2";
+};
+
+&gsw_port3 {
+	status = "okay";
+	label = "lan3";
+};
+
+&gsw_port4 {
+	status = "okay";
+	label = "lan4";
+};
+
+/* --- Flash: offsets VERIFIED from JCOW407 boot capture (14-partition map) --- */
+&nand {
+	status = "okay";
+	econet,bmt;
+	econet,bbt-table-size = <250>;
+
+	partitions: partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "bootloader";
+			reg = <0x0 0x40000>;
+			read-only;
+			/* Real per-device MAC base xx:xx:xx:xx:xx:xx lives here at
+			 * 0x3fe48 (VERIFIED from mtd0 backup; GPON SN tail 0CEBFEC8
+			 * == MAC tail). romfile is gzip-compressed so its 0xa was
+			 * garbage. */
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				macaddr_boot: macaddr@3fe48 {
+					compatible = "mac-base";
+					reg = <0x3fe48 0x6>;
+					#nvmem-cell-cells = <1>;
+				};
+			};
+		};
+
+		/* romfile is a gzip-compressed vendor config blob (ctromfile.cfg) */
+		partition@40000 {
+			label = "romfile";
+			reg = <0x40000 0x40000>;
+		};
+
+		partition@80000 {
+			label = "tclinux";
+			reg = <0x80000 0x2800000>;	/* VERIFIED size */
+			econet,enable-remap;
+		};
+
+		/* rootfs = squashfs (kernel padded to 4MB by tclinux-trx) + jffs2
+		 * overlay tail. Overlaps tclinux like the DASAN H660GM-A reference;
+		 * squashfs starts at 0x80000+0x400000 = 0x480000. linux,rootfs lets
+		 * the kernel mount root + OpenWrt auto-creates rootfs_data overlay. */
+		partition@480000 {
+			label = "rootfs";
+			reg = <0x480000 0x2400000>;	/* 0x480000..0x2880000 (end of tclinux) */
+			linux,rootfs;
+		};
+
+		partition@2880000 {
+			label = "tclinux_slave";
+			reg = <0x2880000 0x2800000>;
+		};
+
+		partition@5080000 {
+			label = "opt0";
+			reg = <0x5080000 0x800000>;
+		};
+
+		partition@5880000 {
+			label = "opt1";
+			reg = <0x5880000 0x800000>;
+		};
+
+		partition@6080000 {
+			label = "ubifs";
+			reg = <0x6080000 0x1a00000>;
+		};
+
+		partition@7a80000 {
+			label = "config";
+			reg = <0x7a80000 0x200000>;
+		};
+
+		partition@7c80000 {
+			label = "ubifs2";
+			reg = <0x7c80000 0x5a00000>;
+		};
+
+		/* reservearea â€” offset/size MATCH DASAN; eeprom offsets inherited (UNVERIFIED) */
+		partition@ddc0000 {
+			label = "reservearea";
+			reg = <0xddc0000 0x240000>;
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				eeprom_reservearea_40000: eeprom@40000 {
+					reg = <0x40000 0x4da8>;
+				};
+
+				eeprom_reservearea_1c0000: eeprom@1c0000 {
+					reg = <0x1c0000 0x400>;
+				};
+			};
+		};
+	};
+};
