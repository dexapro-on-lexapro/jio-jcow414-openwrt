+int gponDevSetGemInfo(ushort gemPortId, unchar isValid, unchar isEncrypted)
+{
+	int RETRY = 3000 ;
+	REG_G_GEM_PORT_CFG gponGemPortCfg ;
+	REG_G_GEM_PORT_STS gponGemPortStatus ;
