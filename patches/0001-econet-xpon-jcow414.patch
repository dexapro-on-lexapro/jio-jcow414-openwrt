+	IO_SREG(G_GEM_PORT_CFG, gponGemPortCfg.Raw) ;
+	
+	while(RETRY--) {
+		gponGemPortStatus.Raw = IO_GREG(G_GEM_PORT_STS) ;
+		if(gponGemPortStatus.Bits.gpid_cmd_done) {
+			return 0 ;
