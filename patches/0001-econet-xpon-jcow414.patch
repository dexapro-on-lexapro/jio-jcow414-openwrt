+		transceiver_param->rx_power= read_data;		
+	#endif /* CONFIG_USE_MT7520_ASIC */
+		//PON_PHY_MSG(PHY_MSG_DBG, "temprature Verify: %.8x\n", transceiver_param->temprature);
