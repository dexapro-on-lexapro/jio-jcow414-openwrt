+#if defined(CONFIG_USE_MT7520_ASIC)
+	phy_int_config((PHY_ILLG_INT|PHYRDY_INT|PHY_LOF_INT|TRANS_LOS_INT)) ;
+#else
+	phy_int_config((PHYRDY_INT|PHY_LOF_INT|TRANS_LOS_INT)) ;
+#endif
+}
