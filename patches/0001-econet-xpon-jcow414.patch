+   * pathCost(2) stpInd(1) dep(1) dep(1) portMac(6) outTdPtr(2) inTdPtr(2) macLearnDepth(1) â€” mask 0xfff8 */
+  { 47, {2,1,1,2,2,2,1,1,1,6,2,2,1,0} },
