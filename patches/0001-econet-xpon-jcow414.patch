+/*****************************************************************************
+******************************************************************************/
+int gponDevGetPloamMsg(PLOAM_RAW_General_T *pPloamMsg)
+{
+	REG_G_PLOAMd_FIFO_STS gponPloamStatus ;
+	int i ;
+	
+	gponPloamStatus.Raw = IO_GREG(G_PLOAMd_FIFO_STS) ;
+	if(gponPloamStatus.Bits.ploamd_fifo_used == 0) {
+		goto ret ;
+	} else if(gponPloamStatus.Bits.ploamd_fifo_used >= 3) {
+		for(i=0 ; i<3 ; i++) {
+			/* BYTE-ORDER FIX (session 7): the FIFO word packs ONU-ID/Msg-ID in the HIGH
+			 * bytes (bits 31:24 / 23:16), but PLOAM_RAW_General_T.raw reads dest_id/msg_id
+			 * from value[] byte0/byte1. On little-endian that read the wrong bytes -> every
+			 * DS PLOAM was dropped as "unknown message" -> stuck at O2. swab32 aligns the
+			 * word so raw.dest_id/msg_id and all payload fields decode correctly. */
+			pPloamMsg->value[i] = swab32(IO_GREG(G_PLOAMd_RDATA)) ;
+		}
+		/* DIAG (session 7, O2->O3): log every downstream PLOAM as read (post-swap). */
+		{ extern int ploam_verbose;
+		if(ploam_verbose || pPloamMsg->raw.dest_id != 0xff)   /* 2026-07-08: log DIRECTED msgs ALWAYS (flood-free: skip onu_id=ff broadcasts) to capture the full OLT->us sequence around the Config_PortID deactivate */
+		printk(KERN_DEBUG "PLOAM-DS: raw %08x %08x %08x | onu_id=%02x msg_id=%02x | act_st=O%u\n",
+			pPloamMsg->value[0], pPloamMsg->value[1], pPloamMsg->value[2],
+			pPloamMsg->raw.dest_id, pPloamMsg->raw.msg_id,
+			IO_GREG(0xbfb640bcu) & 0xf) ; }
+	} else {
+		return -EFAULT ;
+	}
+	
+ret:
+	return gponPloamStatus.Bits.ploamd_fifo_used ;
+}
+
+/*****************************************************************************
+******************************************************************************/
+int gponDevSendPloamMsg(PLOAM_RAW_General_T *pPloamMsg, uint times)
+{
+	int i, j ;
+
+	{
+	extern int tx_ploam_swab ;
+	uint w[3] ;
+	for(j=0 ; j<3 ; j++)
+		w[j] = tx_ploam_swab ? swab32(pPloamMsg->value[j]) : pPloamMsg->value[j] ;
+	/* 2026-07-08 A/B: STOCK writes value[] DIRECTLY (no swab); the port's symmetric TX swab is UNVALIDATED and
+	 * first hits the wire at the O5 Password/ACK (= where OLT deactivates). Log the exact on-wire words. */
+	printk(KERN_DEBUG "PLOAMu-TX swab=%d val=[%08x %08x %08x] wire=[%08x %08x %08x] x%u\n",
+		tx_ploam_swab, pPloamMsg->value[0], pPloamMsg->value[1], pPloamMsg->value[2], w[0], w[1], w[2], times) ;
+	for(i=0 ; i<times ; i++) {
+		for(j=0 ; j<3 ; j++) {
+			IO_SREG(G_PLOAMu_WDATA, w[j]) ;
+		}
+	}
+	}
+
+	return 0 ;
+}
